{% from "macros.html.jinja" import scope %}
<chart-table {{ scope(report_view, candidate) }}>
  <div class="chart-table-title">All candidate designs (ranked)</div>
  <div class="chart-table-content">
    <table>
      <tr class="chart-table-column-headers">
        {% for column in columns %}<th scope="col">{{ column }}</th>{% endfor %}
      </tr>
      {% for row in rows %}
      <tr class="chart-table-row-values">
        {% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}
        <td>{% for button in row.downloads %}<a class="geox-button" href="{{ button.href }}" download="{{ button.filename }}">{{ button.label }}</a> {% endfor %}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  <div class="chart-table-description">{{ note }}</div>
</chart-table>
