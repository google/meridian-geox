{% from "macros.html.jinja" import scope %}
<chart-table {% if id %}id="{{ id }}" {% endif %}{{ scope(audience, candidate) }}>
  {% include "findings.html.jinja" %}
  {% if title %}
    <div class="chart-table-title">{{ title }}</div>
  {% endif %}
  {% if collapsed_summary %}
  <details class="chart-table-details">
    <summary>{{ collapsed_summary }}</summary>
  {% endif %}
  <div class="chart-table-content">
    <table{% if selectable %} class="geox-selectable"{% endif %}>
      <tr class="chart-table-column-headers">
      {% for column_header in column_headers %}
        <th scope="col">{{ column_header }}</th>
      {% endfor %}
      </tr>

      {% for row in row_values %}
      {% set row_id = row_ids[loop.index0] if row_ids else '' %}
      {% set tone = row_tones[loop.index0] if row_tones else 'neutral' %}
      <tr class="chart-table-row-values geox-row-{{ tone }}"{% if row_id %} data-design-id="{{ row_id }}"{% endif %}{% if selectable %} tabindex="0" role="button" aria-pressed="false"{% endif %}>
        {% for value in row %}
          <td>{{ value }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </table>
  </div>
  {% if collapsed_summary %}
  </details>
  {% endif %}
  {% if description %}
    <div class="chart-table-description">{{ description }}</div>
  {% endif %}
</chart-table>
