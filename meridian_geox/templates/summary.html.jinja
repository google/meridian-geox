<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ report.title }}</title>
  <script src="https://www.gstatic.com/external_hosted/vega/vega.js"></script>
  <script src="https://www.gstatic.com/external_hosted/vega_lite/vega-lite.js"></script>
  <script src="https://www.gstatic.com/external_hosted/vega_embed/vega-embed.js"></script>
  <link href="https://fonts.googleapis.com/css?family=Google+Sans:400,500,700" rel="stylesheet">
  <style>{{ style }}</style>
</head>
<body data-geox-view="executive" data-geox-kind="{{ report.kind }}">
  <header class="geox-header">
    <div class="geox-header-main">
      <div class="geox-eyebrow">Meridian GeoX · {{ 'Experiment design' if report.kind == 'design' else 'Experiment analysis' }}</div>
      <h1>{{ report.title }}</h1>
      {% if report.subtitle %}<p class="geox-subtitle">{{ report.subtitle }}</p>{% endif %}
      {% if report.chips %}
      <ul class="geox-chips">
        {% for chip in report.chips %}<li><span>{{ chip.label }}:</span> {{ chip.value }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="geox-header-actions">
      <div class="geox-view-toggle" role="group" aria-label="Report view">
        <button type="button" data-view="executive" aria-pressed="true">Executive summary</button>
        <button type="button" data-view="full" aria-pressed="false">Full report</button>
      </div>
      <button type="button" class="geox-button" id="geox-print">Save Executive PDF</button>
    </div>
  </header>
  <main class="geox-cards">
    {% for card in cards %}{{ card }}{% endfor %}
  </main>
  <footer class="geox-footer">Generated by Meridian GeoX. Charts render with Vega-Lite.</footer>

  <dialog id="geox-source-dialog">
    <form method="dialog" class="geox-dialog-header">
      <strong id="geox-source-title">Chart source</strong>
      <span>
        <button type="button" class="geox-link-button" id="geox-source-copy">Copy</button>
        <button class="geox-link-button" value="close">Close</button>
      </span>
    </form>
    <pre id="geox-source-body"></pre>
  </dialog>

  <script type="application/json" id="geox-specs">{{ chart_specs }}</script>
  {% for key, value in resources.items() %}
  <script type="application/json" id="geox-resource-{{ key }}">{{ value }}</script>
  {% endfor %}
  <script>
  (function() {
    'use strict';
    var RESOURCE_PREFIX = 'geox-resource:';
    var SELECTION_SIGNAL = 'geox_selected_design';
    var specs = JSON.parse(document.getElementById('geox-specs').textContent);
    var views = {};
    var selected = {{ default_candidate|tojson }};

    function resource(key) {
      var el = document.getElementById('geox-resource-' + key);
      return el ? JSON.parse(el.textContent) : null;
    }

    function decodeDataUri(uri) {
      var comma = uri.indexOf(',');
      var meta = uri.substring(5, comma);
      var payload = uri.substring(comma + 1);
      var text;
      if (meta.indexOf(';base64') >= 0) {
        var bytes = Uint8Array.from(atob(payload), function(c) { return c.charCodeAt(0); });
        text = new TextDecoder('utf-8').decode(bytes);
      } else {
        text = decodeURIComponent(payload);
      }
      if (text.charCodeAt(0) === 0xFEFF) { text = text.substring(1); }
      return JSON.parse(text);
    }

    var remoteCache = {};
    function fetchJson(url) {
      if (!remoteCache[url]) {
        remoteCache[url] = fetch(url).then(function(r) { return r.json(); });
      }
      return remoteCache[url];
    }

    // Resolves hoisted resources and remote URLs into inline values so that
    // charts work offline and inside strict sandboxes.
    function geoxInlineData(node) {
      var pending = [];
      (function walk(n) {
        if (Array.isArray(n)) { n.forEach(walk); return; }
        if (!n || typeof n !== 'object') { return; }
        if (typeof n.url === 'string') {
          var url = n.url;
          if (url.indexOf(RESOURCE_PREFIX) === 0) {
            url = resource(url.substring(RESOURCE_PREFIX.length)) || url;
          }
          if (url.indexOf('data:') === 0) {
            try { n.values = decodeDataUri(url); delete n.url; } catch (e) { n.url = url; }
          } else if (/^https?:/.test(url)) {
            var target = n;
            pending.push(fetchJson(url).then(function(v) {
              target.values = v; delete target.url;
            }).catch(function() {}));
          }
        }
        Object.keys(n).forEach(function(k) { walk(n[k]); });
      })(node);
      return Promise.all(pending).then(function() { return node; });
    }

    function embed(id) {
      var el = document.getElementById(id);
      if (!el || !window.vegaEmbed) { return; }
      var spec = JSON.parse(JSON.stringify(specs[id]));
      geoxInlineData(spec).then(function(full) {
        specs[id] = full;
        return vegaEmbed(el, full, {
          renderer: 'svg',
          actions: {export: true, source: false, compiled: false, editor: true}
        });
      }).then(function(result) {
        views[id] = result.view;
        setSignal(result.view, selected);
        result.view.addEventListener('click', function(event, item) {
          if (item && item.datum && item.datum.design_id) {
            select(String(item.datum.design_id));
          }
        });
      }).catch(function(err) {
        el.textContent = 'Chart could not be rendered: ' + err;
      });
    }

    function setSignal(view, value) {
      if (!value) { return; }
      try { view.signal(SELECTION_SIGNAL, value).runAsync(); } catch (e) {}
    }

    function select(id) {
      if (!id) { return; }
      selected = id;
      document.querySelectorAll('.geox-cand').forEach(function(el) {
        el.hidden = el.getAttribute('data-cand') !== id;
      });
      document.querySelectorAll('tr[data-design-id]').forEach(function(row) {
        var on = row.getAttribute('data-design-id') === id;
        row.classList.toggle('geox-selected', on);
        if (row.hasAttribute('aria-pressed')) { row.setAttribute('aria-pressed', String(on)); }
      });
      Object.keys(views).forEach(function(k) { setSignal(views[k], id); });
    }

    function setView(view) {
      document.body.setAttribute('data-geox-view', view);
      document.querySelectorAll('.geox-view-toggle button').forEach(function(b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-view') === view));
      });
      var params = new URLSearchParams(window.location.search);
      if (view === 'full') { params.set('view', 'full'); } else { params.delete('view'); }
      var query = params.toString();
      try {
        history.replaceState(null, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
      } catch (e) {}
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text).catch(function() { legacyCopy(text); });
      }
      legacyCopy(text);
      return Promise.resolve();
    }

    function legacyCopy(text) {
      var area = document.createElement('textarea');
      area.value = text;
      document.body.appendChild(area);
      area.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(area);
    }

    document.querySelectorAll('.geox-view-toggle button').forEach(function(b) {
      b.addEventListener('click', function() { setView(b.getAttribute('data-view')); });
    });
    document.getElementById('geox-print').addEventListener('click', function() {
      var previous = document.body.getAttribute('data-geox-view');
      setView('executive');
      window.print();
      setView(previous);
    });
    document.querySelectorAll('tr[data-design-id]').forEach(function(row) {
      if (!row.closest('.geox-selectable')) { return; }
      row.addEventListener('click', function() { select(row.getAttribute('data-design-id')); });
      row.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(row.getAttribute('data-design-id')); }
      });
    });
    document.querySelectorAll('.geox-copy').forEach(function(b) {
      b.addEventListener('click', function(e) {
        e.stopPropagation();
        var label = b.textContent;
        copyText(b.getAttribute('data-copy')).then(function() {
          b.textContent = 'Copied';
          setTimeout(function() { b.textContent = label; }, 1200);
        });
      });
    });
    var dialog = document.getElementById('geox-source-dialog');
    document.querySelectorAll('[data-source-for]').forEach(function(b) {
      b.addEventListener('click', function() {
        var id = b.getAttribute('data-source-for');
        document.getElementById('geox-source-body').textContent = JSON.stringify(specs[id], null, 2);
        if (dialog.showModal) { dialog.showModal(); } else { dialog.setAttribute('open', ''); }
      });
    });
    document.getElementById('geox-source-copy').addEventListener('click', function() {
      copyText(document.getElementById('geox-source-body').textContent);
    });

    if (new URLSearchParams(window.location.search).get('view') === 'full') { setView('full'); }
    select(selected);
    Object.keys(specs).forEach(embed);
  })();
  </script>
</body>
</html>
